{
  "name": "pocket-push",
  "version": "0.1.0",
  "private": true,
  "license": "FSL-1.1-Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint:types": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run lint:types && pnpm test && pnpm run lint && pnpm run format:check",
    "dry-run": "wrangler deploy --config wrangler.toml --dry-run --outdir dist",
    "deploy": "wrangler deploy --config wrangler.toml"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
